# ============================================================
# CfdmNote — .gitignore
# REGRA DE SEGURANCA: nada que contenha credenciais entra no git.
# ============================================================

# --- BANCOS E CREDENCIAIS (NUNCA COMMITAR) ---
*.kdbx
*.ksdb
*.key
*.keyx
.~lock.*#
# Exports do banco em texto puro (contem coluna Password!)
*-Csv
*.csv
*.CSV
credentials*
secrets*
.env
.env.*

# --- BUILD ---
build/
build-*/
build_*/
AppDir/
.appimage-tools/
*.AppImage
*.o
*.a
*.so
*.so.*
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile
compile_commands.json

# --- IDE / SO ---
.DS_Store
.vscode/
.idea/
*.swp
*~
