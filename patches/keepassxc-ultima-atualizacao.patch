@@ -315,6 +318,47 @@ bool Database::saveAs(const QString& filePath, SaveAction action, const QString&
     int length = Random::instance()->randomUIntRange(64, 512);
     m_metadata->customData()->set(CustomData::RandomSlug, Random::instance()->randomArray(length).toHex());
 
+    // CfdmNote: carimbo "🕒 Atualizações / Última atualização" dentro da própria base, na MESMA gravação.
+    // Se a nota mudou, a gravação aconteceu. O histórico da nota guarda as gravações anteriores.
+    // markAsClean() depois do save pára o temporizador de alteração — não gera nova gravação.
+    if (filePath == m_data.filePath && rootGroup()) {
+        const QString nomeGrupo = QStringLiteral("🕒 Atualizações");
+        const QString tituloNota = QStringLiteral("Última atualização");
+        // Procura em toda a árvore (o grupo pode ter sido arrumado, ex.: "00 Cfdm Holding"), nunca na Lixeira.
+        // Só cria no topo se não existir em lado nenhum — antes procurava só no topo e duplicava o grupo.
+        Group* grupo = nullptr;
+        for (Group* g : rootGroup()->groupsRecursive(false)) {
+            if (g->name() == nomeGrupo && !g->isRecycled()) { grupo = g; break; }
+        }
+        if (!grupo) {
+            grupo = new Group();
+            grupo->setUuid(QUuid::createUuid());
+            grupo->setName(nomeGrupo);
+            grupo->setIcon(8);
+            grupo->setParent(rootGroup());
+        }
+        Entry* nota = nullptr;
+        for (Entry* e : grupo->entries()) {
+            if (e->title() == tituloNota) { nota = e; break; }
+        }
+        if (!nota) {
+            nota = new Entry();
+            nota->setUuid(QUuid::createUuid());
+            nota->setTitle(tituloNota);
+            nota->setIcon(8);
+            nota->setGroup(grupo);
+        }
+        const auto agora = QDateTime::currentDateTime();
+        nota->beginUpdate();
+        nota->setNotes(QStringLiteral("Gravado em: %1\nFicheiro: %2\nNotas na base: %3\nGrupos na base: %4\nGravado por: CfdmNote (desktop) em %5")
+                           .arg(agora.toString(QStringLiteral("dd/MM/yyyy HH:mm:ss")), filePath)
+                           .arg(rootGroup()->entriesRecursive().size())
+                           .arg(rootGroup()->groupsRecursive(true).size())
+                           .arg(QSysInfo::machineHostName()));
+        nota->setUsername(agora.toString(QStringLiteral("dd/MM/yyyy HH:mm:ss")));
+        nota->endUpdate();
+    }
+
     // Prevent destructive operations while saving
     QMutexLocker locker(&m_saveMutex);
 
